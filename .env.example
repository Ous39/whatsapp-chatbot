# Local development defaults only. Never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgresql://oceanbrown:oceanbrown@localhost:5433/oceanbrown
REDIS_URL=redis://localhost:6379
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
# Required to store WhatsApp access tokens. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters
# Public URL of this API (used to show the webhook URL in the dashboard)
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Comma-separated list of dashboard origins allowed by CORS
APP_URL=http://localhost:3000
# Set to true when the API runs behind a reverse proxy / load balancer (correct client IPs for rate limiting)
TRUST_PROXY=false
# Self-service sign-up. Defaults to true in development and false in production.
ALLOW_SIGNUP=
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=oceanbrown
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=change-me-locally

# ---------- WhatsApp Cloud API (see docs/META-SETUP.md) ----------
# Master switch. While false, nothing is ever sent to WhatsApp.
WHATSAPP_LIVE_ENABLED=false
# Meta app > App settings > Basic > App secret (verifies webhook signatures)
META_APP_SECRET=
# Any long random string; paste the same value into Meta's webhook configuration
META_VERIFY_TOKEN=
# Optional fallback token for single-business installs. Per-business tokens are saved (encrypted) in Integrations.
META_ACCESS_TOKEN=
# Optional: `pnpm db:seed` attaches this phone number ID to the demo workspace
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0

# ---------- AI provider ----------
# simulator | anthropic | openai  (falls back to simulator when the key is missing)
AI_PROVIDER=simulator
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override, e.g. claude-haiku-5-5 or claude-sonnet-5-5
AI_MODEL=
