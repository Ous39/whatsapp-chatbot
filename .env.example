# Local development defaults only. Never commit real secrets.
# NODE_ENV must be "development" or "test" for local conveniences (demo seed, fallback JWT secret,
# DEV_EXPOSE_TOKENS). Any other value - including unset - behaves like production.
# docker-compose.yml forces NODE_ENV=production for the api and worker containers whatever this file says.
NODE_ENV=development
# Development only: return password-reset and invitation tokens in API responses (ignored outside development/test)
DEV_EXPOSE_TOKENS=true
DATABASE_URL=postgresql://oceanbrown:oceanbrown@localhost:5433/oceanbrown
REDIS_URL=redis://localhost:6379
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
# Required to store WhatsApp access tokens. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters
# Public URL of this API (used to show the webhook URL in the dashboard)
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Comma-separated list of dashboard origins allowed by CORS
APP_URL=http://localhost:3000
# Behind ONE reverse proxy (Caddy/Nginx) set TRUST_PROXY=1 (number of proxy hops), or list the proxy IPs.
# "true" trusts every X-Forwarded-For value, which lets clients spoof their IP; it is treated as 1 in production.
TRUST_PROXY=false
# Self-service sign-up. Defaults to true in development and false in production.
ALLOW_SIGNUP=
# Transactional email for password resets and team invitations (optional locally, required for production self-service)
RESEND_API_KEY=
EMAIL_FROM=OceanBrown <noreply@your-domain.gm>
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=oceanbrown
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=change-me-locally

# ---------- WhatsApp Cloud API (see docs/META-SETUP.md) ----------
# Master switch. While false, nothing is ever sent to WhatsApp.
WHATSAPP_LIVE_ENABLED=false
# Meta app > App settings > Basic > App secret (verifies webhook signatures)
META_APP_SECRET=
META_APP_ID=
# Configuration ID created under WhatsApp > Embedded Signup in the Meta app dashboard
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Any long random string; paste the same value into Meta's webhook configuration
META_VERIFY_TOKEN=
# Optional system-user token for OceanBrown's OWN WhatsApp number. It is used only by the workspace whose id is in
# META_ACCESS_TOKEN_BUSINESS_ID; every other workspace must save its own token (encrypted) in Integrations.
META_ACCESS_TOKEN=
META_ACCESS_TOKEN_BUSINESS_ID=
# Optional: `pnpm db:seed` attaches this phone number ID to the demo workspace
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0

# ---------- AI provider ----------
# simulator | anthropic | openai  (falls back to simulator when the key is missing)
AI_PROVIDER=simulator
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override, e.g. claude-haiku-5-5 or claude-sonnet-5-5
AI_MODEL=

# ---------- Voice notes (English, French, Wolof) ----------
# Customers can send voice notes; the agent transcribes them and can answer with a voice note.
VOICE_ENABLED=true
# Speech-to-text: elevenlabs (recommended: English, French and Wolof) | openai (English/French) | http (self-hosted) | none
STT_PROVIDER=none
ELEVENLABS_API_KEY=
# STT_MODEL=scribe_v2
# STT_HTTP_URL=
# Text-to-speech per language: openai | elevenlabs | http | none
TTS_EN=none
TTS_FR=none
# Wolof: run services/tts-wolof and point TTS_WO_URL at it
TTS_WO=none
TTS_WO_URL=http://localhost:8000/synthesize
TTS_WO_TOKEN=
# OPENAI_TTS_VOICE=alloy
# ELEVENLABS_VOICE_ID=
# Also send the answer as text after the voice note
VOICE_ALSO_TEXT=true
